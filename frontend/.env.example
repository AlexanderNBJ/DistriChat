APP_NAME=DistriChat
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# MUDANÇA AQUI: Use 'file' para não precisar de banco para sessões
CACHE_STORE=file
LOG_CHANNEL=stack
LOG_LEVEL=debug

# BANCO DE DADOS (SQLite para o frontend)

# REDIS (Nome do container)
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379

# COMUNICAÇÃO COM OS MICROSERVIÇOS (Correto!)

# TEMPO REAL (Navegador acessa via localhost)
APP_URL=http://localhost:8002
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite
SESSION_DRIVER=file
VITE_AUTH_SERVICE_URL=http://localhost:8000/api
VITE_CHAT_SERVICE_URL=http://localhost:8001/api
VITE_REVERB_APP_KEY=tr9eddtrg1pczees5ool
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
