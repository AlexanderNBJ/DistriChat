APP_NAME=ChatService
APP_ENV=local
APP_KEY=
APP_DEBUG=true

LOG_CHANNEL=stack
LOG_LEVEL=debug

# BANCO DE DADOS (Postgres no Docker)
DB_PORT=5432
DB_USERNAME=postgres

# SESSÃO E CACHE
SESSION_DRIVER=file
CACHE_STORE=file

# BROADCAST
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# REDIS
REDIS_CLIENT=phpredis
REDIS_PORT=6379

# REVERB CLIENT SIDE (Para o front via Vite)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# URLs DE COMUNICAÇÃO
